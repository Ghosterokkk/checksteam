
@import url('https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;600&display=swap');
:root{--red:#e90022;--red2:#ff1535;--bg:#020202;--panel:#090909;--line:#1b1b1b;--text:#ddd;--muted:#555;--blue:#173b59}
*{box-sizing:border-box}html{min-height:100%;background:#020202}
body{margin:0;min-height:100vh;color:#d7d7d7;background:
radial-gradient(ellipse at 50% 105%,rgba(70,0,15,.20),transparent 35%),
radial-gradient(ellipse at 8% 88%,rgba(55,0,20,.10),transparent 24%),
radial-gradient(ellipse at 92% 83%,rgba(55,0,20,.10),transparent 24%),#020202;
font-family:'Roboto Mono',monospace;font-size:11px;letter-spacing:.1px}
a{text-decoration:none;color:inherit}.wrap{width:980px;max-width:calc(100% - 34px);margin:0 auto}
.header{height:58px;border-bottom:1px solid #191919;display:flex;align-items:center;justify-content:space-between}
.logo{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600;letter-spacing:2px}
.logo-box{width:24px;height:24px;border-radius:3px;background:#111;box-shadow:inset 0 0 10px #1c1c1c}
.logo .white{color:#eee}.logo .red{color:var(--red)}
.steam{border:1px solid #315b7e;background:linear-gradient(#234761,#17344c);color:#dbe8f1;border-radius:5px;padding:9px 13px;font-weight:600;font-size:10px}
.steam:hover{filter:brightness(1.12)}
.center{min-height:315px;display:flex;align-items:center;justify-content:center;text-align:center}
.hero h1{font-size:18px;margin:0 0 8px;color:#ddd;letter-spacing:1px}
.hero p{margin:0 0 20px;color:#4f4f4f;font-size:10px}
.hero .steam{border-color:#5e1220;box-shadow:0 0 0 1px rgba(233,0,34,.15)}
.footer{padding:0 0 34px;text-align:center;color:#333;font-size:9px;letter-spacing:.3px}
.footer a{color:#c8001c}.footer a:hover{color:#ff2340}.sep{color:#3b3b3b;margin:0 7px}
.user-header{margin-top:12px;border:1px solid #24040a;background:#0d0306;border-radius:5px;height:30px;display:flex;align-items:center;padding:0 12px;gap:9px;color:#a4a4a4}
.user-header .person{color:#7a1531}.user-header b{color:#ddd}.badge{color:#f11b36;font-weight:600}
.top-user{display:flex;align-items:center;gap:10px}.avatar{width:24px;height:24px;border-radius:50%;border:1px solid #7c1021;background:#090909}
.user-actions{margin-left:auto;display:flex;gap:8px;align-items:center}.logout{border:1px solid #252525;border-radius:4px;padding:7px 10px;color:#555}
.tabs{margin-top:9px;display:flex;gap:4px;align-items:center}.tab{border:1px solid #242424;background:#070707;color:#555;padding:6px 12px;border-radius:4px;font-size:9px}
.tab.active{color:#e40024;border-color:#a3001b}.paths{margin-left:auto}
.drop{margin-top:9px;border:1px solid #202020;background:#080808;border-radius:5px;padding:15px}
.dropzone{height:94px;border:1px dashed #252525;border-radius:4px;display:flex;align-items:center;justify-content:center;text-align:center;color:#4b4b4b}
.dropzone b{display:block;font-size:9px;font-weight:500;margin-bottom:6px}.dropzone small{font-size:8px;color:#373737}
.page{padding:25px 0 30px}.back{display:inline-block;border:1px solid #1d1d1d;background:#070707;border-radius:3px;padding:6px 10px;color:#444;font-size:9px}
.article{width:575px;max-width:100%;margin:0 auto;border:1px solid #181818;border-radius:8px;background:rgba(10,10,10,.82);padding:28px 28px 40px}
.article h1{color:#ef1634;font-size:17px;letter-spacing:1px;border-left:2px solid var(--red);padding-left:10px;margin:18px 0 10px}
.article .date{color:#999;margin-bottom:20px;font-size:10px}.article h2{color:#e31a35;font-size:11px;margin:25px 0 10px}.article p,.article li{color:#888;font-size:10px;line-height:1.75}.article strong{color:#ddd}
.notice{border-left:2px solid var(--red);background:#19070a;padding:12px 12px;margin:16px 0}.notice b{color:#ddd}.notice p{margin:5px 0 0}
.method-title{color:#eee;font-size:14px}.method-list{margin-top:14px}.method-item{border-top:1px solid #1a1a1a;padding:13px 0}.method-item b{color:#d70b28}.method-item p{margin:6px 0}
.gmod-head{text-align:center;padding:30px 0 22px}.shield{width:44px;height:44px;border-radius:9px;background:#190309;border:1px solid #470715;display:inline-flex;align-items:center;justify-content:center;color:#f20d30;font-size:23px}.gmod-head h1{margin:10px 0 5px;font-size:20px;letter-spacing:2px}.gmod-head h1 span{color:var(--red)}.gmod-head p{color:#454545;font-size:9px}
.download{display:inline-block;background:#ed001e;border-radius:5px;padding:12px 28px;color:#fff;font-weight:600;margin:18px 0 7px}.download:hover{background:#ff1734}.sub{color:#333;font-size:8px}
.warn{border:1px solid #332a0a;background:#0e0d06;border-radius:8px;padding:14px;margin-top:16px}.warn h3{color:#c4a918;font-size:10px;margin:0 0 8px}.warn ul{margin:0;padding-left:15px}.warn li{margin:8px 0;color:#777}.warn li::marker{color:#ed0021}.screens-title{margin-top:18px;color:#e00022;font-size:9px;border-left:2px solid var(--red);padding-left:8px}.screen-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}.screen{height:85px;border:1px solid #242424;background:linear-gradient(#101010,#050505);border-radius:4px}
@media(max-width:1000px){.wrap{max-width:calc(100% - 28px)}}
@media(max-width:650px){.header{height:54px}.logo{font-size:12px}.steam{padding:8px;font-size:9px}.article{padding:20px}.screen-grid{grid-template-columns:1fr}.center{min-height:260px}}

body:after{content:"";position:fixed;z-index:-1;left:-10%;right:-10%;bottom:-70px;height:430px;pointer-events:none;opacity:.18;
background:
radial-gradient(ellipse at 8% 80%,transparent 0 16%,rgba(120,0,45,.22) 17%,transparent 30%),
radial-gradient(ellipse at 48% 100%,transparent 0 19%,rgba(120,0,45,.20) 20%,transparent 35%),
radial-gradient(ellipse at 91% 80%,transparent 0 15%,rgba(120,0,45,.18) 16%,transparent 31%);
filter:blur(18px)}
